{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ganador1/amy/experiments/verifiable_release_study/schemas/model-review-response.schema.json",
  "title": "A.M.Y advisory model-review response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict", "critical_findings", "hidden_assumptions", "missing_tests",
    "reproducibility_risks", "overclaims", "strongest_falsification_test",
    "uncertainties", "recommended_next_actions"
  ],
  "properties": {
    "verdict": {"enum": ["NO_FATAL_DEFECT_FOUND", "MAJOR_REVISION", "REJECT_CURRENT_DESIGN"]},
    "critical_findings": {
      "type": "array", "maxItems": 40,
      "items": {"$ref": "#/$defs/finding"}
    },
    "hidden_assumptions": {
      "type": "array", "maxItems": 40,
      "items": {"type": "string", "minLength": 10, "maxLength": 4000}
    },
    "missing_tests": {
      "type": "array", "maxItems": 40,
      "items": {"type": "string", "minLength": 10, "maxLength": 4000}
    },
    "reproducibility_risks": {
      "type": "array", "maxItems": 40,
      "items": {"type": "string", "minLength": 10, "maxLength": 4000}
    },
    "overclaims": {
      "type": "array", "maxItems": 40,
      "items": {"type": "string", "minLength": 10, "maxLength": 4000}
    },
    "strongest_falsification_test": {"type": "string", "minLength": 20, "maxLength": 8000},
    "uncertainties": {
      "type": "array", "maxItems": 40,
      "items": {"type": "string", "minLength": 5, "maxLength": 4000}
    },
    "recommended_next_actions": {
      "type": "array", "maxItems": 40,
      "items": {"type": "string", "minLength": 10, "maxLength": 4000}
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id", "severity", "claim", "evidence_paths",
        "verification_steps", "uncertainty"
      ],
      "properties": {
        "finding_id": {"type": "string", "pattern": "^F-[0-9]{3}$"},
        "severity": {"enum": ["BLOCKER", "HIGH", "MEDIUM", "LOW"]},
        "claim": {"type": "string", "minLength": 20, "maxLength": 8000},
        "evidence_paths": {
          "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1000}
        },
        "verification_steps": {"type": "string", "minLength": 20, "maxLength": 8000},
        "uncertainty": {"type": "string", "minLength": 5, "maxLength": 4000}
      }
    }
  }
}

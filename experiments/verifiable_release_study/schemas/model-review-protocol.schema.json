{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ganador1/amy/experiments/verifiable_release_study/schemas/model-review-protocol.schema.json",
  "title": "A.M.Y exploratory multi-model review protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol_id", "status", "classification", "purpose",
    "execution", "common_source_paths", "review_slots", "response_contract",
    "finding_admission", "retention", "boundaries"
  ],
  "properties": {
    "schema_version": {"const": "amy.model-review-protocol.v1"},
    "protocol_id": {"type": "string", "pattern": "^MRP-[0-9]{4}-[0-9]{2}-[0-9]{2}-v[0-9]+$"},
    "status": {"const": "frozen_for_next_exploratory_round"},
    "classification": {"const": "exploratory_advisory_not_scientific_evidence"},
    "purpose": {"type": "string", "minLength": 50, "maxLength": 4000},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_count", "max_parallel_requests", "attempts_per_slot", "retry_allowed",
        "failed_slot_replacement_allowed", "timeout_seconds", "stream", "think",
        "temperature", "num_predict", "request_format", "source_inventory_pre_post_required"
      ],
      "properties": {
        "slot_count": {"const": 10},
        "max_parallel_requests": {"const": 10},
        "attempts_per_slot": {"const": 1},
        "retry_allowed": {"const": false},
        "failed_slot_replacement_allowed": {"const": false},
        "timeout_seconds": {"type": "integer", "minimum": 60, "maximum": 3600},
        "stream": {"const": false},
        "think": {"const": false},
        "temperature": {"const": 0},
        "num_predict": {"type": "integer", "minimum": 1000, "maximum": 20000},
        "request_format": {"const": "closed_json_schema"},
        "source_inventory_pre_post_required": {"const": true}
      }
    },
    "common_source_paths": {
      "type": "array", "minItems": 5, "uniqueItems": true,
      "items": {"$ref": "#/$defs/safePath"}
    },
    "review_slots": {
      "type": "array", "minItems": 10, "maxItems": 10,
      "items": {"$ref": "#/$defs/reviewSlot"}
    },
    "response_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_prompt", "task_template", "required_top_level_keys"],
      "properties": {
        "system_prompt": {"type": "string", "minLength": 100, "maxLength": 8000},
        "task_template": {"type": "string", "minLength": 100, "maxLength": 12000},
        "required_top_level_keys": {
          "type": "array", "minItems": 8, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"}
        }
      }
    },
    "finding_admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_vote_allowed", "majority_rule_allowed", "unverified_finding_may_change_protocol",
        "unverified_finding_may_change_oracle", "unverified_finding_may_change_compatibility",
        "required_verification", "conflict_resolution"
      ],
      "properties": {
        "model_vote_allowed": {"const": false},
        "majority_rule_allowed": {"const": false},
        "unverified_finding_may_change_protocol": {"const": false},
        "unverified_finding_may_change_oracle": {"const": false},
        "unverified_finding_may_change_compatibility": {"const": false},
        "required_verification": {"type": "string", "minLength": 50, "maxLength": 4000},
        "conflict_resolution": {"type": "string", "minLength": 50, "maxLength": 4000}
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_request_bytes", "exact_response_bytes", "empty_responses",
        "transport_errors", "http_errors", "quota_errors", "malformed_model_content",
        "provider_metadata", "source_hashes", "protocol_hash", "silent_drop_allowed"
      ],
      "properties": {
        "exact_request_bytes": {"const": true},
        "exact_response_bytes": {"const": true},
        "empty_responses": {"const": true},
        "transport_errors": {"const": true},
        "http_errors": {"const": true},
        "quota_errors": {"const": true},
        "malformed_model_content": {"const": true},
        "provider_metadata": {"const": true},
        "source_hashes": {"const": true},
        "protocol_hash": {"const": true},
        "silent_drop_allowed": {"const": false}
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmatory_inputs_allowed", "confirmatory_outputs_allowed",
        "model_outputs_are_ground_truth", "satisfies_qualified_human_review",
        "satisfies_external_reproduction", "provider_weights_identified",
        "provider_serving_state_reproducible", "manuscript_claims_authorized"
      ],
      "properties": {
        "confirmatory_inputs_allowed": {"const": false},
        "confirmatory_outputs_allowed": {"const": false},
        "model_outputs_are_ground_truth": {"const": false},
        "satisfies_qualified_human_review": {"const": false},
        "satisfies_external_reproduction": {"const": false},
        "provider_weights_identified": {"const": false},
        "provider_serving_state_reproducible": {"const": false},
        "manuscript_claims_authorized": {"const": false}
      }
    }
  },
  "$defs": {
    "safePath": {
      "type": "string", "minLength": 1, "maxLength": 1000,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "reviewSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id", "model_label", "observed_registration_digest",
        "role", "question", "source_paths"
      ],
      "properties": {
        "slot_id": {"type": "string", "pattern": "^MR-[0-9]{2}$"},
        "model_label": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
        "observed_registration_digest": {
          "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"
        },
        "role": {"type": "string", "minLength": 20, "maxLength": 500},
        "question": {"type": "string", "minLength": 50, "maxLength": 4000},
        "source_paths": {
          "type": "array", "minItems": 2, "uniqueItems": true,
          "items": {"$ref": "#/$defs/safePath"}
        }
      }
    }
  }
}

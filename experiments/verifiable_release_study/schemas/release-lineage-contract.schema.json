{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ganador1/amy/experiments/verifiable_release_study/schemas/release-lineage-contract.schema.json",
  "title": "A.M.Y verifiable-study release-lineage contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_status",
    "classification",
    "lineage_id",
    "prepared_date",
    "normative_source_ids",
    "identity_rules",
    "required_release_identity_fields",
    "software_components",
    "study_toolchain_component",
    "stage_rules",
    "r2_release_records",
    "stages",
    "current_decision",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "amy.release-lineage-contract.v1-draft"
    },
    "record_status": {
      "enum": [
        "draft_not_frozen",
        "frozen"
      ]
    },
    "classification": {
      "const": "pre_registration_identity_contract_no_confirmatory_evidence"
    },
    "lineage_id": {
      "type": "string",
      "pattern": "^amy-verifiable-release-study-lineage-[0-9]{3}$"
    },
    "prepared_date": {
      "type": "string",
      "format": "date"
    },
    "normative_source_ids": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^S[0-9]{2}$"
      }
    },
    "identity_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_hash_algorithm",
        "artifact_digest_scope",
        "git_oid_label",
        "git_oid_is_artifact_sha256",
        "software_version_is_execution_identity",
        "latest_is_execution_identity",
        "version_labels_are_immutable",
        "new_bytes_require_new_version",
        "new_bytes_require_new_manifest",
        "new_bytes_require_new_attestation",
        "published_bytes_may_be_replaced",
        "self_hash_field_allowed",
        "record_digest_location",
        "signature_proves_scientific_truth",
        "signature_proves_authorized_workflow_identity_only_under_policy",
        "rollback_protection_is_stateless"
      ],
      "properties": {
        "artifact_hash_algorithm": {
          "const": "sha256"
        },
        "artifact_digest_scope": {
          "const": "exact_bytes"
        },
        "git_oid_label": {
          "const": "git-object-id-with-explicit-object-format"
        },
        "git_oid_is_artifact_sha256": {
          "const": false
        },
        "software_version_is_execution_identity": {
          "const": false
        },
        "latest_is_execution_identity": {
          "const": false
        },
        "version_labels_are_immutable": {
          "const": true
        },
        "new_bytes_require_new_version": {
          "const": true
        },
        "new_bytes_require_new_manifest": {
          "const": true
        },
        "new_bytes_require_new_attestation": {
          "const": true
        },
        "published_bytes_may_be_replaced": {
          "const": false
        },
        "self_hash_field_allowed": {
          "const": false
        },
        "record_digest_location": {
          "const": "external_parent_reference_and_deposit_metadata"
        },
        "signature_proves_scientific_truth": {
          "const": false
        },
        "signature_proves_authorized_workflow_identity_only_under_policy": {
          "const": true
        },
        "rollback_protection_is_stateless": {
          "const": false
        }
      }
    },
    "required_release_identity_fields": {
      "const": [
        "stage",
        "stage_version",
        "repository_uri",
        "git_object_format",
        "source_commit_oid",
        "source_tree_oid",
        "source_snapshot_sha256",
        "dependency_lock_sha256",
        "execution_image_digest",
        "payload_manifest_sha256",
        "attestation_policy_sha256",
        "trusted_root_sha256",
        "attestation_bundle_sha256",
        "verifier_binary_sha256",
        "result_schema_sha256",
        "transport_archive_sha256",
        "version_doi",
        "publication_timestamp"
      ]
    },
    "software_components": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/softwareComponent"
      }
    },
    "study_toolchain_component": {
      "allOf": [
        {
          "$ref": "#/$defs/softwareComponent"
        },
        {
          "properties": {
            "name": {
              "const": "amy-verifiable-release-study"
            }
          }
        }
      ]
    },
    "stage_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "R0",
        "R1",
        "R2"
      ],
      "properties": {
        "R0": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "freeze_before_confirmatory_generation",
            "may_contain_confirmatory_outputs",
            "required_parent_stages"
          ],
          "properties": {
            "freeze_before_confirmatory_generation": {
              "const": true
            },
            "may_contain_confirmatory_outputs": {
              "const": false
            },
            "required_parent_stages": {
              "const": []
            }
          }
        },
        "R1": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generated_only_after_R0_registration",
            "must_be_generated_by_exact_R0",
            "may_rewrite_R0",
            "required_parent_stages"
          ],
          "properties": {
            "generated_only_after_R0_registration": {
              "const": true
            },
            "must_be_generated_by_exact_R0": {
              "const": true
            },
            "may_rewrite_R0": {
              "const": false
            },
            "required_parent_stages": {
              "const": [
                "R0"
              ]
            }
          }
        },
        "R2": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "must_cite_exact_R0_and_R1",
            "may_rewrite_R0_or_R1",
            "correction_creates_new_R2",
            "correction_records_are_append_only",
            "correction_supersedes_exact_prior_R2",
            "prior_R2_records_must_be_preserved",
            "required_parent_stages"
          ],
          "properties": {
            "must_cite_exact_R0_and_R1": {
              "const": true
            },
            "may_rewrite_R0_or_R1": {
              "const": false
            },
            "correction_creates_new_R2": {
              "const": true
            },
            "correction_records_are_append_only": {
              "const": true
            },
            "correction_supersedes_exact_prior_R2": {
              "const": true
            },
            "prior_R2_records_must_be_preserved": {
              "const": true
            },
            "required_parent_stages": {
              "const": [
                "R0",
                "R1"
              ]
            }
          }
        }
      }
    },
    "r2_release_records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/r2ReleaseRecord"
      }
    },
    "stages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/stageState"
      }
    },
    "current_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "freeze_permitted_now",
        "blocking_reasons"
      ],
      "properties": {
        "decision": {
          "enum": [
            "GO",
            "NO-GO"
          ]
        },
        "freeze_permitted_now": {
          "type": "boolean"
        },
        "blocking_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "record_status": {
            "const": "draft_not_frozen"
          }
        },
        "required": [
          "record_status"
        ]
      },
      "then": {
        "properties": {
          "current_decision": {
            "properties": {
              "decision": {
                "const": "NO-GO"
              },
              "freeze_permitted_now": {
                "const": false
              },
              "blocking_reasons": {
                "minItems": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "current_decision": {
            "properties": {
              "decision": {
                "const": "GO"
              },
              "freeze_permitted_now": {
                "const": true
              },
              "blocking_reasons": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitOid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "gitOidSha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "gitOidSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "softwareComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "distribution_identity",
        "declared_version",
        "git_object_format",
        "source_commit_oid",
        "source_tree_oid",
        "source_snapshot_sha256",
        "dependency_lock_sha256",
        "execution_image_digest",
        "resolution_status"
      ],
      "properties": {
        "name": {
          "enum": [
            "A.M.Y",
            "Atlas",
            "AXIOM",
            "amy-verifiable-release-study"
          ]
        },
        "distribution_identity": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "declared_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "git_object_format": {
          "enum": [
            "sha1",
            "sha256",
            null
          ]
        },
        "source_commit_oid": {
          "anyOf": [
            {
              "$ref": "#/$defs/gitOid"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_tree_oid": {
          "anyOf": [
            {
              "$ref": "#/$defs/gitOid"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_snapshot_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "dependency_lock_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "execution_image_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "resolution_status": {
          "enum": [
            "unresolved_before_R0",
            "frozen"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "git_object_format": {
                "const": "sha1"
              }
            },
            "required": [
              "git_object_format"
            ]
          },
          "then": {
            "properties": {
              "source_commit_oid": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/gitOidSha1"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_tree_oid": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/gitOidSha1"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "git_object_format": {
                "const": "sha256"
              }
            },
            "required": [
              "git_object_format"
            ]
          },
          "then": {
            "properties": {
              "source_commit_oid": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/gitOidSha256"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_tree_oid": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/gitOidSha256"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "git_object_format": {
                "type": "null"
              }
            },
            "required": [
              "git_object_format"
            ]
          },
          "then": {
            "properties": {
              "source_commit_oid": {
                "type": "null"
              },
              "source_tree_oid": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "parentReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "release_record_sha256",
        "payload_manifest_sha256",
        "transport_archive_sha256",
        "version_doi"
      ],
      "properties": {
        "stage": {
          "enum": [
            "R0",
            "R1"
          ]
        },
        "release_record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "payload_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "transport_archive_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "version_doi": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "releaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "stage_version",
        "repository_uri",
        "git_object_format",
        "source_commit_oid",
        "source_tree_oid",
        "source_snapshot_sha256",
        "dependency_lock_sha256",
        "execution_image_digest",
        "payload_manifest_sha256",
        "attestation_policy_sha256",
        "trusted_root_sha256",
        "attestation_bundle_sha256",
        "verifier_binary_sha256",
        "result_schema_sha256",
        "transport_archive_sha256",
        "version_doi",
        "publication_timestamp"
      ],
      "properties": {
        "stage": {
          "enum": [
            "R0",
            "R1",
            "R2"
          ]
        },
        "stage_version": {
          "type": "string",
          "minLength": 1
        },
        "repository_uri": {
          "type": "string",
          "format": "uri"
        },
        "git_object_format": {
          "enum": [
            "sha1",
            "sha256"
          ]
        },
        "source_commit_oid": {
          "$ref": "#/$defs/gitOid"
        },
        "source_tree_oid": {
          "$ref": "#/$defs/gitOid"
        },
        "source_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "dependency_lock_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "execution_image_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "payload_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "attestation_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "trusted_root_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "attestation_bundle_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "verifier_binary_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "result_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "transport_archive_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "version_doi": {
          "type": "string",
          "format": "uri"
        },
        "concept_doi": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "publication_timestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "git_object_format": {
                "const": "sha1"
              }
            },
            "required": [
              "git_object_format"
            ]
          },
          "then": {
            "properties": {
              "source_commit_oid": {
                "$ref": "#/$defs/gitOidSha1"
              },
              "source_tree_oid": {
                "$ref": "#/$defs/gitOidSha1"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "git_object_format": {
                "const": "sha256"
              }
            },
            "required": [
              "git_object_format"
            ]
          },
          "then": {
            "properties": {
              "source_commit_oid": {
                "$ref": "#/$defs/gitOidSha256"
              },
              "source_tree_oid": {
                "$ref": "#/$defs/gitOidSha256"
              }
            }
          }
        }
      ]
    },
    "r2ReleaseRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_kind",
        "release_record_sha256",
        "supersedes_release_record_sha256",
        "correction_reason",
        "parents",
        "identity"
      ],
      "properties": {
        "record_kind": {
          "enum": [
            "initial_publication",
            "correction"
          ]
        },
        "release_record_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "supersedes_release_record_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "correction_reason": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "parents": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/parentReference"
          }
        },
        "identity": {
          "$ref": "#/$defs/releaseIdentity"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "record_kind": {
                "const": "initial_publication"
              }
            },
            "required": [
              "record_kind"
            ]
          },
          "then": {
            "properties": {
              "supersedes_release_record_sha256": {
                "type": "null"
              },
              "correction_reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "supersedes_release_record_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "correction_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "stageState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "status",
        "version_label",
        "contains_or_derives_from_confirmatory_outputs",
        "parents",
        "identity",
        "registration_identifier",
        "external_record_sha256",
        "unresolved_fields",
        "freeze_permitted"
      ],
      "properties": {
        "stage": {
          "enum": [
            "R0",
            "R1",
            "R2"
          ]
        },
        "status": {
          "enum": [
            "not_created",
            "draft_not_frozen",
            "frozen_unpublished",
            "published"
          ]
        },
        "version_label": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "contains_or_derives_from_confirmatory_outputs": {
          "type": "boolean"
        },
        "parents": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/parentReference"
          }
        },
        "identity": {
          "anyOf": [
            {
              "$ref": "#/$defs/releaseIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "registration_identifier": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "external_record_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "unresolved_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "freeze_permitted": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "frozen_unpublished",
                  "published"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "identity": {
                "$ref": "#/$defs/releaseIdentity"
              },
              "registration_identifier": {
                "type": "string",
                "minLength": 1
              },
              "external_record_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "unresolved_fields": {
                "maxItems": 0
              },
              "freeze_permitted": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "freeze_permitted": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_created"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "version_label": {
                "type": "null"
              },
              "identity": {
                "type": "null"
              },
              "registration_identifier": {
                "type": "null"
              },
              "external_record_sha256": {
                "type": "null"
              },
              "parents": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}

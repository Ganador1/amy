    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "references",
        "disposition",
        "summary",
        "rationale",
        "required_change"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HRF-[0-9]{3,6}$"
        },
        "scope": {
          "enum": [
          "ORACLE_ROW",
          "CATALOG_CASE",
            "PROPOSITION",
            "COMPATIBILITY_MATRIX_ROW",
            "COMPATIBILITY_POLICY",
            "CROSS_CUTTING"
          ]
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "disposition": {
          "enum": ["INFORMATIONAL", "REQUIRED_CHANGE"]
        },
        "summary": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10000
        },
        "rationale": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            }
          ]
        },
        "required_change": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"disposition": {"const": "REQUIRED_CHANGE"}},
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "rationale": {"type": "string", "minLength": 10},
              "required_change": {"type": "string", "minLength": 10}
            }
          },
          "else": {
            "properties": {
              "required_change": {"type": "null"}
            }
          }
        }
      ]
    },
    "authenticationBoundaryAcknowledgements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_record_bytes_require_detached_sigstore_authentication",
        "separately_authorized_reviewer_identity_policy_required",
        "consumer_must_compare_subject_hashes_to_external_values",
        "authentication_establishes_bytes_and_identity_under_policy_only",
        "authentication_does_not_establish_reviewer_competence",
        "authentication_does_not_establish_scientific_truth"
      ],
      "properties": {
        "raw_record_bytes_require_detached_sigstore_authentication": {"const": true},
        "separately_authorized_reviewer_identity_policy_required": {"const": true},
        "consumer_must_compare_subject_hashes_to_external_values": {"const": true},
        "authentication_establishes_bytes_and_identity_under_policy_only": {"const": true},
        "authentication_does_not_establish_reviewer_competence": {"const": true},
        "authentication_does_not_establish_scientific_truth": {"const": true}
      }
    },
    "templateRecordState": {
      "required": [
        "record_status",
        "independent_human_review_occurred",
        "subject_binding",
        "reviewer",
        "declarations",
        "reviewed_at",
        "catalog_case_decisions",
        "oracle_row_decisions",
        "proposition_decisions",
        "compatibility_policy_decisions",
        "manuscript_skeleton_decision",
        "findings",
        "overall_decision"
      ],
      "properties": {
        "record_status": {"const": "template_unreviewed"},
        "independent_human_review_occurred": {"const": false},
        "subject_binding": {"$ref": "#/$defs/templateSubjectBinding"},
        "reviewer": {"type": "null"},
        "declarations": {"$ref": "#/$defs/templateDeclarations"},
        "reviewed_at": {"type": "null"},
        "catalog_case_decisions": {"$ref": "#/$defs/templateCatalogDecisions"},
        "oracle_row_decisions": {"$ref": "#/$defs/templateOracleDecisions"},
        "proposition_decisions": {"$ref": "#/$defs/templatePropositionDecisions"},
        "compatibility_policy_decisions": {
          "$ref": "#/$defs/templateCompatibilityDecisions"
        },
        "manuscript_skeleton_decision": {"$ref": "#/$defs/templateDecision"},
        "findings": {"maxItems": 0},
        "overall_decision": {"const": "NOT_REVIEWED"}
      }
    },
    "submittedRecordState": {
      "required": [
        "record_status",
        "independent_human_review_occurred",
        "subject_binding",
        "reviewer",
        "declarations",
        "reviewed_at",
        "catalog_case_decisions",
        "oracle_row_decisions",
        "proposition_decisions",
        "compatibility_policy_decisions",
        "manuscript_skeleton_decision",
        "findings",
        "overall_decision"
      ],
      "properties": {
        "record_status": {"const": "submitted"},
        "independent_human_review_occurred": {"const": true},
        "subject_binding": {"$ref": "#/$defs/submittedSubjectBinding"},
        "reviewer": {"$ref": "#/$defs/reviewer"},
        "declarations": {"$ref": "#/$defs/submittedDeclarations"},
        "reviewed_at": {"$ref": "#/$defs/rfc3339"},
        "catalog_case_decisions": {"$ref": "#/$defs/submittedCatalogDecisions"},
        "oracle_row_decisions": {"$ref": "#/$defs/submittedOracleDecisions"},
        "proposition_decisions": {
          "$ref": "#/$defs/submittedPropositionDecisions"
        },
        "compatibility_policy_decisions": {
          "$ref": "#/$defs/submittedCompatibilityDecisions"
        },
        "manuscript_skeleton_decision": {"$ref": "#/$defs/submittedDecision"},
        "overall_decision": {
          "enum": ["APPROVE", "REQUIRES_CHANGES", "REJECT"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"overall_decision": {"const": "APPROVE"}},
            "required": ["overall_decision"]
          },
          "then": {
            "properties": {
              "catalog_case_decisions": {
                "$ref": "#/$defs/agreementCatalogDecisions"
              },
              "oracle_row_decisions": {
                "$ref": "#/$defs/agreementOracleDecisions"
              },
              "proposition_decisions": {
                "$ref": "#/$defs/agreementPropositionDecisions"
              },
              "compatibility_policy_decisions": {
                "$ref": "#/$defs/agreementCompatibilityDecisions"
              },
              "manuscript_skeleton_decision": {
                "$ref": "#/$defs/agreementDecision"
              },
              "findings": {
                "not": {
                  "contains": {
                    "properties": {
                      "disposition": {"const": "REQUIRED_CHANGE"}
                    },
                    "required": ["disposition"]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "overall_decision": {
                "enum": ["REQUIRES_CHANGES", "REJECT"]
              }
            },
            "required": ["overall_decision"]
          },
          "then": {
            "properties": {
              "findings": {
                "minItems": 1,
                "contains": {
                  "properties": {
                    "disposition": {"const": "REQUIRED_CHANGE"}
                  },
                  "required": ["disposition"]
                },
                "minContains": 1
              }
            }
          }
        }
      ]
    }
  }

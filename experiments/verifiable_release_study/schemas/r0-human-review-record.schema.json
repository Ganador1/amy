{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ganador1/amy/experiments/verifiable_release_study/schemas/r0-human-review-record.schema.json",
  "title": "A.M.Y R0 human-review record for RG-004",
  "description": "Closed, fail-closed contract for either the shipped unreviewed template or a future externally authenticated, SHA-bound human-review record. Schema validity alone never closes RG-004.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_status",
    "gate_id",
    "record_purpose",
    "independent_human_review_occurred",
    "subject_binding",
    "reviewer",
    "declarations",
    "reviewed_at",
    "catalog_case_decisions",
    "oracle_row_decisions",
    "proposition_decisions",
    "compatibility_policy_decisions",
    "manuscript_skeleton_decision",
    "findings",
    "overall_decision",
    "authentication_boundary_acknowledgements"
  ],
  "properties": {
    "schema_version": {
      "const": "amy.r0-human-review-record.v1-draft"
    },
    "record_status": {
      "enum": ["template_unreviewed", "submitted"]
    },
    "gate_id": {
      "const": "RG-004"
    },
    "record_purpose": {
      "const": "future_RG-004_human_review_of_exact_R0_subject_bytes"
    },
    "independent_human_review_occurred": {
      "type": "boolean"
    },
    "subject_binding": {
      "oneOf": [
        {"$ref": "#/$defs/templateSubjectBinding"},
        {"$ref": "#/$defs/submittedSubjectBinding"}
      ]
    },
    "reviewer": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/reviewer"}
      ]
    },
    "declarations": {
      "oneOf": [
        {"$ref": "#/$defs/templateDeclarations"},
        {"$ref": "#/$defs/submittedDeclarations"}
      ]
    },
    "reviewed_at": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/rfc3339"}
      ]
    },
    "catalog_case_decisions": {
      "oneOf": [
        {"$ref": "#/$defs/templateCatalogDecisions"},
        {"$ref": "#/$defs/submittedCatalogDecisions"}
      ]
    },
    "oracle_row_decisions": {
      "oneOf": [
        {"$ref": "#/$defs/templateOracleDecisions"},
        {"$ref": "#/$defs/submittedOracleDecisions"}
      ]
    },
    "proposition_decisions": {
      "oneOf": [
        {"$ref": "#/$defs/templatePropositionDecisions"},
        {"$ref": "#/$defs/submittedPropositionDecisions"}
      ]
    },
    "compatibility_policy_decisions": {
      "oneOf": [
        {"$ref": "#/$defs/templateCompatibilityDecisions"},
        {"$ref": "#/$defs/submittedCompatibilityDecisions"}
      ]
    },
    "manuscript_skeleton_decision": {
      "oneOf": [
        {"$ref": "#/$defs/templateDecision"},
        {"$ref": "#/$defs/submittedDecision"}
      ]
    },
    "findings": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "overall_decision": {
      "enum": ["NOT_REVIEWED", "APPROVE", "REQUIRES_CHANGES", "REJECT"]
    },
    "authentication_boundary_acknowledgements": {
      "$ref": "#/$defs/authenticationBoundaryAcknowledgements"
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/templateRecordState"},
    {"$ref": "#/$defs/submittedRecordState"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rfc3339": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "templateSubjectBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_manifest_path",
        "subject_manifest_sha256",
        "packet_path",
        "packet_sha256",
        "hash_source"
      ],
      "properties": {
        "subject_manifest_path": {"const": "R0_REVIEW_SUBJECT_MANIFEST.jcs.json"},
        "subject_manifest_sha256": {"type": "null"},
        "packet_path": {"const": "R0_REVIEW_PACKET.tar"},
        "packet_sha256": {"type": "null"},
        "hash_source": {"const": "not_supplied_template_unreviewed"}
      }
    },
    "submittedSubjectBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_manifest_path",
        "subject_manifest_sha256",
        "packet_path",
        "packet_sha256",
        "hash_source"
      ],
      "properties": {
        "subject_manifest_path": {"const": "R0_REVIEW_SUBJECT_MANIFEST.jcs.json"},
        "subject_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "packet_path": {"const": "R0_REVIEW_PACKET.tar"},
        "packet_sha256": {"$ref": "#/$defs/sha256"},
        "hash_source": {
          "const": "externally_supplied_and_must_be_compared_by_consumer"
        }
      }
    },
    "reviewerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "enum": [
            "email",
            "orcid",
            "institutional_account",
            "sigstore_certificate_identity",
            "other_stable_identity"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000
        }
      }
    },
    "reviewerQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "relevant_experience", "evidence_uris"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 20,
          "maxLength": 10000
        },
        "relevant_experience": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 2000
          }
        },
        "evidence_uris": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "maxLength": 4000
          }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "affiliation", "identity", "qualification"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "affiliation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "identity": {
          "$ref": "#/$defs/reviewerIdentity"
        },
        "qualification": {
          "$ref": "#/$defs/reviewerQualification"
        }
      }
    },
    "templateDeclarations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
      "did_not_implement_verifier",
      "did_not_implement_mutation_generator",
      "did_not_implement_analysis",
      "did_not_author_catalog_cases",
      "did_not_author_oracle_expectations",
      "did_not_author_propositions",
      "did_not_author_manuscript_skeleton",
      "project_author_or_investigator",
      "confirmatory_outcomes_accessed",
      "subject_write_access_during_review",
      "prior_development_case_outcomes_accessed",
      "employment_or_supervisory_conflict",
      "shared_funding_conflict",
      "financial_or_consulting_conflict",
      "personal_or_competing_interest",
      "compensation_disclosure",
      "conflict_of_interest_present",
        "disqualifying_conflict_present",
        "conflict_disclosure",
        "independence_statement"
      ],
      "properties": {
      "did_not_implement_verifier": {"type": "null"},
      "did_not_implement_mutation_generator": {"type": "null"},
      "did_not_implement_analysis": {"type": "null"},
      "did_not_author_catalog_cases": {"type": "null"},
      "did_not_author_oracle_expectations": {"type": "null"},
      "did_not_author_propositions": {"type": "null"},
      "did_not_author_manuscript_skeleton": {"type": "null"},
      "project_author_or_investigator": {"type": "null"},
      "confirmatory_outcomes_accessed": {"type": "null"},
      "subject_write_access_during_review": {"type": "null"},
      "prior_development_case_outcomes_accessed": {"type": "null"},
      "employment_or_supervisory_conflict": {"type": "null"},
      "shared_funding_conflict": {"type": "null"},
      "financial_or_consulting_conflict": {"type": "null"},
      "personal_or_competing_interest": {"type": "null"},
      "compensation_disclosure": {"type": "null"},
      "conflict_of_interest_present": {"type": "null"},
        "disqualifying_conflict_present": {"type": "null"},
        "conflict_disclosure": {"type": "null"},
        "independence_statement": {"type": "null"}
      }
    },
    "submittedDeclarations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
      "did_not_implement_verifier",
      "did_not_implement_mutation_generator",
      "did_not_implement_analysis",
      "did_not_author_catalog_cases",
      "did_not_author_oracle_expectations",
      "did_not_author_propositions",
      "did_not_author_manuscript_skeleton",
      "project_author_or_investigator",
      "confirmatory_outcomes_accessed",
      "subject_write_access_during_review",
      "prior_development_case_outcomes_accessed",
      "employment_or_supervisory_conflict",
      "shared_funding_conflict",
      "financial_or_consulting_conflict",
      "personal_or_competing_interest",
      "compensation_disclosure",
      "conflict_of_interest_present",
        "disqualifying_conflict_present",
        "conflict_disclosure",
        "independence_statement"
      ],
      "properties": {
      "did_not_implement_verifier": {"const": true},
      "did_not_implement_mutation_generator": {"const": true},
      "did_not_implement_analysis": {"const": true},
      "did_not_author_catalog_cases": {"const": true},
      "did_not_author_oracle_expectations": {"const": true},
      "did_not_author_propositions": {"const": true},
      "did_not_author_manuscript_skeleton": {"const": true},
      "project_author_or_investigator": {"const": false},
      "confirmatory_outcomes_accessed": {"const": false},
      "subject_write_access_during_review": {"const": false},
      "prior_development_case_outcomes_accessed": {"const": false},
      "employment_or_supervisory_conflict": {"const": false},
      "shared_funding_conflict": {"const": false},
      "financial_or_consulting_conflict": {"const": false},
      "personal_or_competing_interest": {"const": false},
      "compensation_disclosure": {
        "type": "string",
        "minLength": 4,
        "maxLength": 10000
      },
      "conflict_of_interest_present": {"const": false},
        "disqualifying_conflict_present": {"const": false},
        "conflict_disclosure": {
          "type": "string",
          "minLength": 4,
          "maxLength": 10000
        },
        "independence_statement": {
          "type": "string",
          "minLength": 20,
          "maxLength": 10000
        }
      }
    },
    "templateDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "rationale"],
      "properties": {
        "decision": {"const": "NOT_REVIEWED"},
        "rationale": {"type": "null"}
      }
    },
    "submittedDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "rationale"],
      "properties": {
        "decision": {
          "enum": ["AGREE", "DISAGREE", "REQUIRES_CHANGE"]
        },
        "rationale": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "decision": {"enum": ["DISAGREE", "REQUIRES_CHANGE"]}
            },
            "required": ["decision"]
          },
          "then": {
            "properties": {
              "rationale": {
                "type": "string",
                "minLength": 10,
                "maxLength": 10000
              }
            }
          }
        }
      ]
    },
    "agreementDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "rationale"],
      "properties": {
        "decision": {"const": "AGREE"},
        "rationale": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            }
          ]
        }
      }
    },
    "templateCatalogDecisions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 41,
      "maxProperties": 41,
      "patternProperties": {
        "^(?:ATTESTATION-MALFORMED-001|ATTESTATION-MISSING-001|BUILD-DIRTY-001|BUILD-METADATA-MISSING-001|BUILDER-PREDICATE-MISMATCH-001|CERTIFICATE-TIME-001|CLEAN-001|CONTENT-BITFLIP-001|CONTENT-SAME-SIZE-001|CONTENT-TRUNCATE-001|EXECUTION-IMAGE-MISMATCH-001|IDENTITY-WORKFLOW-001|INVENTORY-EXTRA-001|INVENTORY-MISSING-001|INVENTORY-OMIT-ROLE-001|MANIFEST-DUPLICATE-KEY-001|MANIFEST-MALFORMED-001|MANIFEST-MISSING-001|MANIFEST-NONCANONICAL-001|MANIFEST-SCHEMA-001|MANIFEST-SELF-HASH-001|MATERIAL-LOCK-MISMATCH-001|PATH-DUPLICATE-NORMALIZED-001|PATH-HARDLINK-001|PATH-NONREGULAR-001|PATH-PARENT-001|PATH-SYMLINK-001|PREDICATE-WRONG-TYPE-001|RESOURCE-MANIFEST-LIMIT-001|SIGNATURE-ALGORITHM-001|SIGNATURE-CORRUPT-001|SNAPSHOT-DIGEST-MISMATCH-001|SNAPSHOT-ROLE-MISMATCH-001|SOURCE-TREE-MISMATCH-001|SOURCE-WRONG-REVISION-001|STATEMENT-MALFORMED-001|SUBJECT-REPLAY-001|SUBSTITUTION-COHERENT-001|SUBSTITUTION-UNAUTHORIZED-001|TRANSPARENCY-MISSING-001|WORKFLOW-PARAMETER-MISMATCH-001)$": {
          "$ref": "#/$defs/templateDecision"
        }
      }
    },
    "submittedCatalogDecisions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 41,
      "maxProperties": 41,
      "patternProperties": {
        "^(?:ATTESTATION-MALFORMED-001|ATTESTATION-MISSING-001|BUILD-DIRTY-001|BUILD-METADATA-MISSING-001|BUILDER-PREDICATE-MISMATCH-001|CERTIFICATE-TIME-001|CLEAN-001|CONTENT-BITFLIP-001|CONTENT-SAME-SIZE-001|CONTENT-TRUNCATE-001|EXECUTION-IMAGE-MISMATCH-001|IDENTITY-WORKFLOW-001|INVENTORY-EXTRA-001|INVENTORY-MISSING-001|INVENTORY-OMIT-ROLE-001|MANIFEST-DUPLICATE-KEY-001|MANIFEST-MALFORMED-001|MANIFEST-MISSING-001|MANIFEST-NONCANONICAL-001|MANIFEST-SCHEMA-001|MANIFEST-SELF-HASH-001|MATERIAL-LOCK-MISMATCH-001|PATH-DUPLICATE-NORMALIZED-001|PATH-HARDLINK-001|PATH-NONREGULAR-001|PATH-PARENT-001|PATH-SYMLINK-001|PREDICATE-WRONG-TYPE-001|RESOURCE-MANIFEST-LIMIT-001|SIGNATURE-ALGORITHM-001|SIGNATURE-CORRUPT-001|SNAPSHOT-DIGEST-MISMATCH-001|SNAPSHOT-ROLE-MISMATCH-001|SOURCE-TREE-MISMATCH-001|SOURCE-WRONG-REVISION-001|STATEMENT-MALFORMED-001|SUBJECT-REPLAY-001|SUBSTITUTION-COHERENT-001|SUBSTITUTION-UNAUTHORIZED-001|TRANSPARENCY-MISSING-001|WORKFLOW-PARAMETER-MISMATCH-001)$": {
          "$ref": "#/$defs/submittedDecision"
        }
      }
    },
    "agreementCatalogDecisions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 41,
      "maxProperties": 41,
      "patternProperties": {
        "^(?:ATTESTATION-MALFORMED-001|ATTESTATION-MISSING-001|BUILD-DIRTY-001|BUILD-METADATA-MISSING-001|BUILDER-PREDICATE-MISMATCH-001|CERTIFICATE-TIME-001|CLEAN-001|CONTENT-BITFLIP-001|CONTENT-SAME-SIZE-001|CONTENT-TRUNCATE-001|EXECUTION-IMAGE-MISMATCH-001|IDENTITY-WORKFLOW-001|INVENTORY-EXTRA-001|INVENTORY-MISSING-001|INVENTORY-OMIT-ROLE-001|MANIFEST-DUPLICATE-KEY-001|MANIFEST-MALFORMED-001|MANIFEST-MISSING-001|MANIFEST-NONCANONICAL-001|MANIFEST-SCHEMA-001|MANIFEST-SELF-HASH-001|MATERIAL-LOCK-MISMATCH-001|PATH-DUPLICATE-NORMALIZED-001|PATH-HARDLINK-001|PATH-NONREGULAR-001|PATH-PARENT-001|PATH-SYMLINK-001|PREDICATE-WRONG-TYPE-001|RESOURCE-MANIFEST-LIMIT-001|SIGNATURE-ALGORITHM-001|SIGNATURE-CORRUPT-001|SNAPSHOT-DIGEST-MISMATCH-001|SNAPSHOT-ROLE-MISMATCH-001|SOURCE-TREE-MISMATCH-001|SOURCE-WRONG-REVISION-001|STATEMENT-MALFORMED-001|SUBJECT-REPLAY-001|SUBSTITUTION-COHERENT-001|SUBSTITUTION-UNAUTHORIZED-001|TRANSPARENCY-MISSING-001|WORKFLOW-PARAMETER-MISMATCH-001)$": {
          "$ref": "#/$defs/agreementDecision"
        }
      }
    },
    "templateOracleDecisions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 164,
      "maxProperties": 164,
      "patternProperties": {
        "^(?:ATTESTATION-MALFORMED-001|ATTESTATION-MISSING-001|BUILD-DIRTY-001|BUILD-METADATA-MISSING-001|BUILDER-PREDICATE-MISMATCH-001|CERTIFICATE-TIME-001|CLEAN-001|CONTENT-BITFLIP-001|CONTENT-SAME-SIZE-001|CONTENT-TRUNCATE-001|EXECUTION-IMAGE-MISMATCH-001|IDENTITY-WORKFLOW-001|INVENTORY-EXTRA-001|INVENTORY-MISSING-001|INVENTORY-OMIT-ROLE-001|MANIFEST-DUPLICATE-KEY-001|MANIFEST-MALFORMED-001|MANIFEST-MISSING-001|MANIFEST-NONCANONICAL-001|MANIFEST-SCHEMA-001|MANIFEST-SELF-HASH-001|MATERIAL-LOCK-MISMATCH-001|PATH-DUPLICATE-NORMALIZED-001|PATH-HARDLINK-001|PATH-NONREGULAR-001|PATH-PARENT-001|PATH-SYMLINK-001|PREDICATE-WRONG-TYPE-001|RESOURCE-MANIFEST-LIMIT-001|SIGNATURE-ALGORITHM-001|SIGNATURE-CORRUPT-001|SNAPSHOT-DIGEST-MISMATCH-001|SNAPSHOT-ROLE-MISMATCH-001|SOURCE-TREE-MISMATCH-001|SOURCE-WRONG-REVISION-001|STATEMENT-MALFORMED-001|SUBJECT-REPLAY-001|SUBSTITUTION-COHERENT-001|SUBSTITUTION-UNAUTHORIZED-001|TRANSPARENCY-MISSING-001|WORKFLOW-PARAMETER-MISMATCH-001)::P[0-3]$": {
          "$ref": "#/$defs/templateDecision"
        }
      }
    },
    "submittedOracleDecisions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 164,
      "maxProperties": 164,
      "patternProperties": {
        "^(?:ATTESTATION-MALFORMED-001|ATTESTATION-MISSING-001|BUILD-DIRTY-001|BUILD-METADATA-MISSING-001|BUILDER-PREDICATE-MISMATCH-001|CERTIFICATE-TIME-001|CLEAN-001|CONTENT-BITFLIP-001|CONTENT-SAME-SIZE-001|CONTENT-TRUNCATE-001|EXECUTION-IMAGE-MISMATCH-001|IDENTITY-WORKFLOW-001|INVENTORY-EXTRA-001|INVENTORY-MISSING-001|INVENTORY-OMIT-ROLE-001|MANIFEST-DUPLICATE-KEY-001|MANIFEST-MALFORMED-001|MANIFEST-MISSING-001|MANIFEST-NONCANONICAL-001|MANIFEST-SCHEMA-001|MANIFEST-SELF-HASH-001|MATERIAL-LOCK-MISMATCH-001|PATH-DUPLICATE-NORMALIZED-001|PATH-HARDLINK-001|PATH-NONREGULAR-001|PATH-PARENT-001|PATH-SYMLINK-001|PREDICATE-WRONG-TYPE-001|RESOURCE-MANIFEST-LIMIT-001|SIGNATURE-ALGORITHM-001|SIGNATURE-CORRUPT-001|SNAPSHOT-DIGEST-MISMATCH-001|SNAPSHOT-ROLE-MISMATCH-001|SOURCE-TREE-MISMATCH-001|SOURCE-WRONG-REVISION-001|STATEMENT-MALFORMED-001|SUBJECT-REPLAY-001|SUBSTITUTION-COHERENT-001|SUBSTITUTION-UNAUTHORIZED-001|TRANSPARENCY-MISSING-001|WORKFLOW-PARAMETER-MISMATCH-001)::P[0-3]$": {
          "$ref": "#/$defs/submittedDecision"
        }
      }
    },
    "agreementOracleDecisions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 164,
      "maxProperties": 164,
      "patternProperties": {
        "^(?:ATTESTATION-MALFORMED-001|ATTESTATION-MISSING-001|BUILD-DIRTY-001|BUILD-METADATA-MISSING-001|BUILDER-PREDICATE-MISMATCH-001|CERTIFICATE-TIME-001|CLEAN-001|CONTENT-BITFLIP-001|CONTENT-SAME-SIZE-001|CONTENT-TRUNCATE-001|EXECUTION-IMAGE-MISMATCH-001|IDENTITY-WORKFLOW-001|INVENTORY-EXTRA-001|INVENTORY-MISSING-001|INVENTORY-OMIT-ROLE-001|MANIFEST-DUPLICATE-KEY-001|MANIFEST-MALFORMED-001|MANIFEST-MISSING-001|MANIFEST-NONCANONICAL-001|MANIFEST-SCHEMA-001|MANIFEST-SELF-HASH-001|MATERIAL-LOCK-MISMATCH-001|PATH-DUPLICATE-NORMALIZED-001|PATH-HARDLINK-001|PATH-NONREGULAR-001|PATH-PARENT-001|PATH-SYMLINK-001|PREDICATE-WRONG-TYPE-001|RESOURCE-MANIFEST-LIMIT-001|SIGNATURE-ALGORITHM-001|SIGNATURE-CORRUPT-001|SNAPSHOT-DIGEST-MISMATCH-001|SNAPSHOT-ROLE-MISMATCH-001|SOURCE-TREE-MISMATCH-001|SOURCE-WRONG-REVISION-001|STATEMENT-MALFORMED-001|SUBJECT-REPLAY-001|SUBSTITUTION-COHERENT-001|SUBSTITUTION-UNAUTHORIZED-001|TRANSPARENCY-MISSING-001|WORKFLOW-PARAMETER-MISMATCH-001)::P[0-3]$": {
          "$ref": "#/$defs/agreementDecision"
        }
      }
    },
    "templatePropositionDecisions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 12,
      "maxProperties": 12,
      "patternProperties": {
        "^PR-(?:001|002|003|004|005|006|007|008|009|010|011|012)$": {
          "$ref": "#/$defs/templateDecision"
        }
      }
    },
    "submittedPropositionDecisions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 12,
      "maxProperties": 12,
      "patternProperties": {
        "^PR-(?:001|002|003|004|005|006|007|008|009|010|011|012)$": {
          "$ref": "#/$defs/submittedDecision"
        }
      }
    },
    "agreementPropositionDecisions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 12,
      "maxProperties": 12,
      "patternProperties": {
        "^PR-(?:001|002|003|004|005|006|007|008|009|010|011|012)$": {
          "$ref": "#/$defs/agreementDecision"
        }
      }
    },
    "templateCompatibilityRowDecisions": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 246,

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ganador1/amy/experiments/verifiable_release_study/schemas/selected-profile-fixture-result.schema.json",
  "title": "A.M.Y selected-profile controlled-fixture result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "decision",
    "primary_reason",
    "checks",
    "input",
    "details",
    "boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "amy.selected-profile-fixture-result.v1-draft"
    },
    "profile_id": {
      "enum": ["P0", "P1", "P2", "P3"]
    },
    "decision": {
      "enum": ["ACCEPT", "REJECT", "ERROR"]
    },
    "primary_reason": {
      "$ref": "#/$defs/reasonCode"
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bounded_input",
        "manifest_json_syntax",
        "manifest_schema",
        "manifest_canonicality",
        "path_safety",
        "closed_world_inventory",
        "payload_digests",
        "attestation_structure",
        "algorithm_policy",
        "signature_crypto",
        "certificate_time",
        "signer_policy",
        "transparency",
        "subject_binding",
        "provenance_policy"
      ],
      "properties": {
        "bounded_input": {"$ref": "#/$defs/checkState"},
        "manifest_json_syntax": {"$ref": "#/$defs/checkState"},
        "manifest_schema": {"$ref": "#/$defs/checkState"},
        "manifest_canonicality": {"$ref": "#/$defs/checkState"},
        "path_safety": {"$ref": "#/$defs/checkState"},
        "closed_world_inventory": {"$ref": "#/$defs/checkState"},
        "payload_digests": {"$ref": "#/$defs/checkState"},
        "attestation_structure": {"$ref": "#/$defs/checkState"},
        "algorithm_policy": {"$ref": "#/$defs/checkState"},
        "signature_crypto": {"$ref": "#/$defs/checkState"},
        "certificate_time": {"$ref": "#/$defs/checkState"},
        "signer_policy": {"$ref": "#/$defs/checkState"},
        "transparency": {"$ref": "#/$defs/checkState"},
        "subject_binding": {"$ref": "#/$defs/checkState"},
        "provenance_policy": {"$ref": "#/$defs/checkState"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "attestation_sha256"],
      "properties": {
        "manifest_sha256": {"$ref": "#/$defs/nullableSha256"},
        "attestation_sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "details": {
      "type": "object"
    },
    "boundary": {
      "const": "controlled_fixture_not_production_sigstore_not_confirmatory"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "ACCEPT"}}},
      "then": {
        "properties": {
          "primary_reason": {"const": "OK"},
          "details": {"maxProperties": 0}
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "REJECT"}}},
      "then": {
        "properties": {
          "primary_reason": {"$ref": "#/$defs/rejectReasonCode"}
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "ERROR"}}},
      "then": {
        "properties": {
          "primary_reason": {"const": "INTERNAL_ERROR"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "checkState": {
      "enum": ["PASS", "FAIL", "NOT_RUN", "NOT_REQUIRED"]
    },
    "reasonCode": {
      "enum": [
        "OK",
        "RESOURCE_LIMIT",
        "INPUT_MISSING",
        "JSON_INVALID",
        "DUPLICATE_JSON_KEY",
        "MANIFEST_NONCANONICAL",
        "SCHEMA_INVALID",
        "UNSAFE_PATH",
        "DUPLICATE_PATH",
        "SYMLINK_FORBIDDEN",
        "HARDLINK_FORBIDDEN",
        "NONREGULAR_FILE",
        "INPUT_CHANGED",
        "REQUIRED_ROLE_MISSING",
        "PAYLOAD_MISSING",
        "UNEXPECTED_FILE",
        "SIZE_MISMATCH",
        "DIGEST_MISMATCH",
        "ATTESTATION_MISSING",
        "ATTESTATION_INVALID",
        "ALGORITHM_UNAPPROVED",
        "SIGNATURE_INVALID",
        "CERTIFICATE_TIME_INVALID",
        "TRANSPARENCY_INVALID",
        "SIGNER_UNAUTHORIZED",
        "BUILDER_UNAUTHORIZED",
        "SUBJECT_MISMATCH",
        "PREDICATE_TYPE_UNSUPPORTED",
        "SOURCE_MISMATCH",
        "DIRTY_BUILD",
        "MATERIAL_MISMATCH",
        "ATTESTATION_AMBIGUOUS",
        "TRUST_ROOT_MISMATCH",
        "PROVENANCE_INVALID",
        "INTERNAL_ERROR"
      ]
    },
    "rejectReasonCode": {
      "enum": [
        "RESOURCE_LIMIT",
        "INPUT_MISSING",
        "JSON_INVALID",
        "DUPLICATE_JSON_KEY",
        "MANIFEST_NONCANONICAL",
        "SCHEMA_INVALID",
        "UNSAFE_PATH",
        "DUPLICATE_PATH",
        "SYMLINK_FORBIDDEN",
        "HARDLINK_FORBIDDEN",
        "NONREGULAR_FILE",
        "INPUT_CHANGED",
        "REQUIRED_ROLE_MISSING",
        "PAYLOAD_MISSING",
        "UNEXPECTED_FILE",
        "SIZE_MISMATCH",
        "DIGEST_MISMATCH",
        "ATTESTATION_MISSING",
        "ATTESTATION_INVALID",
        "ALGORITHM_UNAPPROVED",
        "SIGNATURE_INVALID",
        "CERTIFICATE_TIME_INVALID",
        "TRANSPARENCY_INVALID",
        "SIGNER_UNAUTHORIZED",
        "BUILDER_UNAUTHORIZED",
        "SUBJECT_MISMATCH",
        "PREDICATE_TYPE_UNSUPPORTED",
        "SOURCE_MISMATCH",
        "DIRTY_BUILD",
        "MATERIAL_MISMATCH",
        "ATTESTATION_AMBIGUOUS",
        "TRUST_ROOT_MISMATCH",
        "PROVENANCE_INVALID"
      ]
    }
  }
}

{
  "schema_version": "amy.r0-reviewer-identity-policy.v1-draft",
  "status": "template_not_authorized_not_frozen",
  "gate_id": "RG-004",
  "purpose": "preauthorize_one_exact_reviewer_identity_and_verification_environment_before_R0_review",
  "source_basis": [
    {
      "source_id": "S14",
      "uri": "https://docs.sigstore.dev/cosign/signing/signing_with_blobs/",
      "supports": "Cosign signs exact files as blobs and recommends retaining a Sigstore bundle containing verification material."
    },
    {
      "source_id": "S15",
      "uri": "https://docs.sigstore.dev/cosign/verifying/verify/",
      "supports": "Keyless blob verification requires the blob, bundle, expected certificate identity, and expected OIDC issuer."
    },
    {
      "source_id": "S25",
      "uri": "https://docs.sigstore.dev/about/bundle/",
      "supports": "The v0.3 bundle format can carry a message signature, certificate, signed-time evidence, and transparency-log entries."
    },
    {
      "source_id": "S45",
      "uri": "https://github.com/sigstore/cosign/security/advisories/GHSA-whqx-f9j3-ch6m",
      "supports": "Affected Cosign versions could accept an unrelated Rekor entry; 2.6.2 and 3.0.4 are the first patched releases in their major lines."
    },
    {
      "source_id": "S46",
      "uri": "https://github.com/sigstore/cosign/blob/main/doc/cosign_verify-blob.md",
      "supports": "The verify-blob command exposes exact identity, exact issuer, trusted-root, bundle, timeout, and insecure bypass controls."
    }
  ],
  "record_contract": {
    "path": "R0_HUMAN_REVIEW_RECORD_SUBMITTED.json",
    "digest_algorithm": "sha256",
    "maximum_bytes": 16777216,
    "raw_bytes_are_signature_subject": true,
    "post_signature_transformation_allowed": false
  },
  "bundle_contract": {
    "path": "R0_HUMAN_REVIEW_RECORD.sigstore.json",
    "media_type": "application/vnd.dev.sigstore.bundle.v0.3+json",
    "content_kind": "messageSignature",
    "minimum_tlog_entries": 1,
    "signed_time_evidence_required": true,
    "rekor_entry_must_bind_record_digest_signature_and_public_key": true
  },
  "identity": {
    "certificate_identity": null,
    "certificate_oidc_issuer": null,
    "identity_regex_allowed": false,
    "issuer_regex_allowed": false,
    "authorized_by": null,
    "authorization_record_uri": null,
    "authorization_record_sha256": null
  },
  "trusted_root": {
    "path": "trusted_root.json",
    "sha256": null,
    "source_uri": null,
    "acquired_at": null
  },
  "tool": {
    "name": "cosign",
    "command": "verify-blob",
    "selected_version": null,
    "platform": null,
    "binary_sha256": null,
    "release_uri": null,
    "required_flags": [
      "--bundle",
      "--trusted-root",
      "--certificate-identity",
      "--certificate-oidc-issuer"
    ],
    "forbidden_flags": [
      "--certificate-identity-regexp",
      "--certificate-oidc-issuer-regexp",
      "--insecure-ignore-sct",
      "--insecure-ignore-tlog"
    ],
    "timeout_seconds": 180,
    "stdout_max_bytes": 1048576,
    "stderr_max_bytes": 1048576,
    "network_allowed_during_verification": false
  },
  "security_floor": {
    "advisory_uri": "https://github.com/sigstore/cosign/security/advisories/GHSA-whqx-f9j3-ch6m",
    "rejected_version_ranges": ["<=2.6.1", "<=3.0.3"],
    "minimum_patched_version_by_major": {"2": "2.6.2", "3": "3.0.4"},
    "selected_version_reviewed_against_advisory": false
  },
  "decision_boundary": {
    "policy_freeze_permitted": false,
    "authentication_execution_permitted": false,
    "rg004_completion_permitted_without_successful_external_checks": false
  },
  "claim_boundary": "A successful detached signature check authenticates exact record bytes under this exact policy; it does not establish reviewer authorization beyond the cited authorization record, competence, independence, care, conflict disclosure truth, scientific correctness, or RG-004 completion."
}
